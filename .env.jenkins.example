# Jenkins local CI stack — copy to .env.jenkins (gitignored) before:
#   podman compose -f docker-compose.jenkins.yml up --build -d
#
# Use disposable values for local CI only. Never use production secrets here.

POSTGRES_DB=skytouch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-ci-db-password

JWT_SECRET=your-ci-jwt-secret-at-least-32-characters-long
MAIL_USERNAME=ci-test@example.com
MAIL_PASSWORD=your-ci-mail-placeholder
