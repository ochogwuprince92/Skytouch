# Server
PORT=8083

# Database
DATASOURCE_URL=jdbc:postgresql://localhost:5432/skytouch_db
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=your-db-password
POSTGRES_DB=skytouch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_CONNECTION_TIMEOUT=30000
MAIL_TIMEOUT=30000
MAIL_WRITE_TIMEOUT=30000
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# App
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
APP_EMAIL_FROM=your-email@gmail.com
APP_LOG_OTP=true
MAIL_SEND_ENABLED=true
APP_FRONTEND_URL=http://localhost:4174
