# Server
PORT=8083

# Database
DATASOURCE_URL=jdbc:postgresql://localhost:5432/skytouch_db
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=your-db-password
POSTGRES_DB=skytouch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_CONNECTION_TIMEOUT=30000
MAIL_TIMEOUT=30000
MAIL_WRITE_TIMEOUT=30000
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# App
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
APP_EMAIL_FROM=your-email@gmail.com
APP_LOG_OTP=true
MAIL_SEND_ENABLED=true
APP_FRONTEND_URL=http://localhost:4174

# Admin bootstrap (first-run only; creates ADMIN if none exists)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# Job alert digest scheduler
JOB_ALERT_DIGEST_ENABLED=true
JOB_ALERT_DIGEST_CRON=0 0 8 * * *
JOB_ALERT_DIGEST_LOOKBACK_HOURS=24

# Offer expiry scheduler
OFFER_EXPIRY_ENABLED=true
OFFER_EXPIRY_CRON=0 0 * * * *

# Cloudinary (CV upload) — set CLOUDINARY_ENABLED=true with valid dashboard credentials for production
CLOUDINARY_ENABLED=false
LOCAL_UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google address validation (Geocoding API)
ADDRESS_VALIDATION_ENABLED=true
GOOGLE_ADDRESS_API_KEY=your-google-maps-api-key
GOOGLE_ADDRESS_VALIDATION_ENDPOINT=https://maps.googleapis.com/maps/api/geocode/json